# ==========================================
# Настройки AI-провайдера (Ollama / OpenAI-compatible)
# ==========================================

# Провайдер по умолчанию: "ollama" | "openai"
AI_PROVIDER=ollama

# --- Вариант 1: Локальная Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# --- Вариант 2: OpenAI / Groq / OpenRouter (при AI_PROVIDER=openai) ---
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=sk-...